<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(FrameworkBase)</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>OpenTabletDriver.Slim</AssemblyName>
    <RootNamespace>OpenTabletDriver.Slim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTabletDriver\OpenTabletDriver.csproj" />
    <ProjectReference Include="..\OpenTabletDriver.Configurations\OpenTabletDriver.Configurations.csproj" />
    <ProjectReference Include="..\OpenTabletDriver.Native\OpenTabletDriver.Native.csproj" />
    <ProjectReference Include="..\OpenTabletDriver.Plugin\OpenTabletDriver.Plugin.csproj" />
    <ProjectReference Include="..\OpenTabletDriver.Wintab\OpenTabletDriver.Wintab.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\wintab-shim\target\release\Wintab32.dll"
                      LogicalName="Wintab32.dll"
                      Condition="Exists('..\..\..\wintab-shim\target\release\Wintab32.dll')" />
    <None Include="..\..\..\wintab-shim\target\release\Wintab32.dll"
          Link="WintabNative\Wintab32.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\..\..\wintab-shim\target\release\Wintab32.dll')" />
  </ItemGroup>

</Project>
