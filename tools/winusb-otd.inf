[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49F0-BC3D-A4FF138216D6}
Provider    = %Provider%
DriverVer   = 11/13/2026,1.0.0.0

[Manufacturer]
%Provider% = OTD,NTamd64

[OTD.NTamd64]
%DeviceName% = WINUSB_Install, USB\VID_056A&PID_0357&MI_01

[WINUSB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[WINUSB_Install.HW]
Include = winusb.inf
Needs   = WINUSB.NT.HW
AddReg  = WINUSB_Install_HW

[WINUSB_Install_HW]
HKR,,DeviceInterfaceGUIDs,0x10000,"{dee824ef-729b-4a0e-9c14-b7117d33a817}"

[WINUSB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[Strings]
Provider     = "OpenTabletDriver"
DeviceName   = "Wacom PTH-660 WinUSB interface"
